# THE VAULT - Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env files with real secrets to git!

# ────────────────────────────────────────────────────────────────────────────────
# Core Secrets (REQUIRED)
# ────────────────────────────────────────────────────────────────────────────────

# JWT signing secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your-secure-jwt-secret-here-min-32-chars

# Your domain (e.g., vault.example.com or localhost:3000)
VAULT_DOMAIN=localhost:3000
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────────────────
# Stripe Configuration
# ────────────────────────────────────────────────────────────────────────────────

# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ────────────────────────────────────────────────────────────────────────────────
# OAuth Providers (Optional - only set if you use them)
# ────────────────────────────────────────────────────────────────────────────────

# Google OAuth
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Twitter/X OAuth  
# Get from: https://developer.twitter.com/en/portal/dashboard
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# ────────────────────────────────────────────────────────────────────────────────
# External APIs (Optional - only set if you use them)
# ────────────────────────────────────────────────────────────────────────────────

# OpenAI API
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Coinbase Crypto API
# Get from: https://www.coinbase.com/settings/api
COINBASE_API_KEY=your-coinbase-api-key

# ────────────────────────────────────────────────────────────────────────────────
# Wallet connect (public, inlined at Vite build time)
# ────────────────────────────────────────────────────────────────────────────────

# Required only for the WalletConnect QR option (Rainbow mobile, and other
# WalletConnect wallets). Create a project at https://cloud.reown.com
# Do not commit a real project id. Injected wallets work without this.
# Vite inlines VITE_ names on its own. The Pages project stores the same
# publishable id as WALLETCONNECT_PROJECT_ID, which the Vite config also reads.
# Set one of these names. Leave them empty to ship injected wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=
# Alias accepted by the app. Set one of these, not both, unless they match.
# VITE_REOWN_PROJECT_ID=
# REOWN_PROJECT_ID=

# ────────────────────────────────────────────────────────────────────────────────
# Database (Cloudflare D1)
# ────────────────────────────────────────────────────────────────────────────────
# These are set automatically by wrangler - no need to set here
# DB binding comes from wrangler.toml: [[d1_databases]] binding = "DB"

# For local development with D1:
# DATABASE_URL=file:./db/local.db

# ────────────────────────────────────────────────────────────────────────────────
# Development & Logging
# ────────────────────────────────────────────────────────────────────────────────

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# Enable detailed API logging
DEBUG_API=false

# ────────────────────────────────────────────────────────────────────────────────
# Security Settings
# ────────────────────────────────────────────────────────────────────────────────

# Session timeout in minutes
SESSION_TIMEOUT=1440

# Rate limit: requests per minute (login/register endpoints)
RATE_LIMIT_STRICT=5
RATE_LIMIT_NORMAL=100

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ────────────────────────────────────────────────────────────────────────────────
# Notes:
# ────────────────────────────────────────────────────────────────────────────────
# - For Cloudflare deployment, set secrets via:
#   npx wrangler pages secret put VARIABLE_NAME "value" --env production
#
# - For local development, copy this to .env and fill in values
#
# - Secrets starting with VITE_ are exposed to the frontend (use only for public keys)
#
# - All SECRET keys should be kept private and never committed to git
#
# - Update .env.example with new required variables when adding features
